<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Mã thể loại *" android:textColor="@color/ink" android:textSize="13sp" android:textStyle="bold"/>
        <EditText android:id="@+id/editGenreCode" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:hint="VD: NHACVANG" android:inputType="textCapCharacters" android:singleLine="true" android:maxLength="30" style="@style/InputField"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="13dp" android:text="Tên thể loại *" android:textColor="@color/ink" android:textSize="13sp" android:textStyle="bold"/>
        <EditText android:id="@+id/editGenreName" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:hint="VD: Nhạc vàng" android:singleLine="true" android:maxLength="100" style="@style/InputField"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="13dp" android:text="Độ tuổi phù hợp *" android:textColor="@color/ink" android:textSize="13sp" android:textStyle="bold"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="6dp" android:gravity="center_vertical">
            <EditText android:id="@+id/editMinAge" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:inputType="number" android:hint="Từ tuổi" android:singleLine="true" style="@style/InputField"/>
            <TextView android:layout_width="38dp" android:layout_height="wrap_content" android:text="đến" android:gravity="center" android:textSize="13sp" android:textColor="@color/subtle"/>
            <EditText android:id="@+id/editMaxAge" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:inputType="number" android:hint="Đến tuổi" android:singleLine="true" style="@style/InputField"/>
        </LinearLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Độ tuổi hợp lệ: từ 0 đến 120. Người trên 40 tuổi được tính từ 41 tuổi." style="@style/BodyMuted"/>
    </LinearLayout>
</ScrollView>
