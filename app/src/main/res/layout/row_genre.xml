<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_card" android:padding="17dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
        <TextView android:layout_width="47dp" android:layout_height="47dp" android:text="♫" android:textSize="27sp" android:textColor="@color/purple" android:gravity="center" android:background="@drawable/bg_cover"/>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="12dp">
            <TextView android:id="@+id/genreName" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Nhạc trữ tình" style="@style/TitleSmall"/>
            <TextView android:id="@+id/genreCode" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="TRUTINH" android:layout_marginTop="3dp" android:textSize="12sp" android:textColor="@color/subtle"/>
        </LinearLayout>
        <TextView android:id="@+id/genreSongs" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0 bài" android:textColor="@color/purple" android:background="@drawable/bg_chip" android:paddingStart="10dp" android:paddingEnd="10dp" android:paddingTop="5dp" android:paddingBottom="5dp" android:textSize="12sp"/>
    </LinearLayout>
    <TextView android:id="@+id/genreAge" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="13dp" android:layout_marginBottom="12dp" android:text="Độ tuổi nghe: 30 – 100 tuổi" style="@style/BodyMuted"/>
    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/line"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="end" android:layout_marginTop="11dp">
        <Button android:id="@+id/btnEditGenre" android:layout_width="90dp" android:layout_height="40dp" android:text="Sửa" style="@style/ActionOutline"/>
        <Button android:id="@+id/btnDeleteGenre" android:layout_width="90dp" android:layout_height="40dp" android:layout_marginStart="10dp" android:text="Xóa" style="@style/ActionOutline" android:textColor="@color/red"/>
    </LinearLayout>
</LinearLayout>
